---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description: string;
  /** Absolute or root-relative path. Astro resolves canonical from Astro.url. */
  canonicalPath?: string;
  /** Override the og:image — defaults to /og.png (the umbrella card). */
  ogImage?: string;
  /** Marks the active nav link. */
  active?: 'home' | 'sheets' | 'editor' | 'slides' | 'desktop' | 'docs' | 'notes' | 'changelog' | 'about';
  /** Per-page JSON-LD payload (will be JSON.stringify'd). */
  jsonLd?: object;
  /** Theme color hint sent in the meta tag. */
  themeColor?: string;
  /** Comma-separated keyword list for the keywords meta (SEO/AEO). */
  keywords?: string;
}

const {
  title,
  description,
  canonicalPath,
  ogImage = '/og.png',
  active = 'home',
  jsonLd,
  themeColor = '#f4f1ea',
  // Default umbrella keyword set — every page inherits these search
  // intents; product pages pass a tighter list. Targets the high-volume
  // "open source / self-hosted alternative to <Google/Microsoft>" queries.
  keywords = 'open source office suite, self-hosted Google Docs alternative, open source Google Sheets alternative, collaborative document editor, real-time co-editing, open source OnlyOffice alternative, self-hosted collaborative editor, browser xlsx editor, browser docx editor, online spreadsheet editor, open source office software',
} = Astro.props as Props;

const SITE_URL = 'https://casualoffice.org';
const canonical = canonicalPath
  ? new URL(canonicalPath, SITE_URL).toString()
  : new URL(Astro.url.pathname, SITE_URL).toString();
const ogImageAbs = new URL(ogImage, SITE_URL).toString();

// GEO / LLM-answerability: when a page doesn't supply its own JSON-LD, emit an
// Organization + WebSite graph so generative engines and rich results have a
// clean, machine-readable description of the suite to quote.
const defaultJsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': `${SITE_URL}/#org`,
      name: 'Casual Office',
      url: SITE_URL,
      logo: `${SITE_URL}/favicon.svg`,
      description:
        'Casual Office is an open-source, self-hosted office suite for editing native Microsoft Office documents (.xlsx, .docx, .pptx, PDF) in the browser, with real-time collaboration.',
      sameAs: ['https://github.com/CasualOffice'],
    },
    {
      '@type': 'WebSite',
      '@id': `${SITE_URL}/#website`,
      url: SITE_URL,
      name: 'Casual Office',
      publisher: { '@id': `${SITE_URL}/#org` },
      inLanguage: 'en',
    },
  ],
};
const structuredData = jsonLd ?? defaultJsonLd;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords} />
    <meta name="author" content="Sachin Sarwa" />
    <meta name="theme-color" content={themeColor} />
    <meta name="color-scheme" content="light dark" />

    {/* Pre-paint theme bootstrap — set .dark on <html> from the saved choice
        (or the OS setting) BEFORE first paint, so dark mode never flashes. */}
    <script is:inline>
      (function () {
        try {
          var saved = localStorage.getItem('theme');
          var dark = saved ? saved === 'dark'
            : window.matchMedia('(prefers-color-scheme: dark)').matches;
          if (dark) {
            document.documentElement.classList.add('dark');
            var m = document.querySelector('meta[name="theme-color"]');
            if (m) m.setAttribute('content', '#14121a');
          }
        } catch (e) {}
      })();
    </script>

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Casual Office" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageAbs} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />
    <meta property="og:locale" content="en_US" />

    <!-- Twitter / X card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageAbs} />
    <meta name="twitter:image:alt" content={title} />

    <meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1" />

    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/favicon.svg" />

    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />

    {/* Self-hosted IBM Plex — no CDN round-trip, no render-block, no silent
        fallback. Preload the variable sans (the face used above the fold); the
        @font-face rules live in global.css. */}
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href="/fonts/plex-sans-variable.woff2"
      crossorigin
    />

    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-J47QDJKSN8" is:inline></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-J47QDJKSN8');
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="aurora" aria-hidden="true"></div>
    <Nav active={active} />
    <main id="main" tabindex="-1"><slot /></main>
    <Footer />

    <!-- Scroll-reveal — adds a fade-rise to any element with .reveal as it
         enters the viewport. Pure IntersectionObserver, no library. The CSS
         already neutralises this under prefers-reduced-motion, and we skip
         the observer entirely if the user asked for reduced motion. -->
    <script is:inline>
      (function () {
        var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        var els = document.querySelectorAll('.reveal');
        if (reduce || !('IntersectionObserver' in window)) {
          els.forEach(function (el) { el.classList.add('is-visible'); });
          return;
        }
        var io = new IntersectionObserver(function (entries) {
          entries.forEach(function (e) {
            if (e.isIntersecting) { e.target.classList.add('is-visible'); io.unobserve(e.target); }
          });
        }, { rootMargin: '0px 0px -10% 0px', threshold: 0.08 });
        els.forEach(function (el) { io.observe(el); });
      })();
    </script>
  </body>
</html>
