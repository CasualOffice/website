---
import Base from '../../layouts/Base.astro';
import LiveFrame from '../../components/LiveFrame.astro';

const title = 'OpenCalc — an embeddable Rust spreadsheet engine with a WebAssembly grid · Casual Office';
const description =
  'OpenCalc is an embeddable spreadsheet engine written in Rust. It reads and writes .xlsx, calculates 347 of the 356 spec functions, renders a live canvas grid, and runs entirely client-side as WebAssembly — so co-editing scales without sticky sessions. Embed it with @opencalc/sheet on npm, as a Rust crate, or behind WOPI. Apache-2.0. Alpha.';

// Alpha. `sdk-v0.0.0` is the first published npm line (2026-08-10); the engine
// crates are not on a published version yet, which is why the status reads
// "alpha" rather than a number.
const sdkVersion = '0.0.0';
const repoUrl = 'https://github.com/CasualOffice/opencalc';
const siteUrl = 'https://calc.casualoffice.org/';
const editorUrl = 'https://calc.casualoffice.org/editor.html';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  '@id': 'https://calc.casualoffice.org/#app',
  name: 'OpenCalc',
  applicationCategory: 'DeveloperApplication',
  applicationSubCategory: 'SpreadsheetApplication',
  operatingSystem: 'Web Browser, Docker, Linux, macOS, Windows',
  url: siteUrl,
  codeRepository: repoUrl,
  softwareVersion: `sdk-${sdkVersion}`,
  license: 'https://www.apache.org/licenses/LICENSE-2.0',
  description:
    'Embeddable Rust spreadsheet engine: .xlsx round-trip as a semantic fixed point, 347 of 356 spec functions, dynamic arrays, LET and LAMBDA, pivot tables, real chart parts, and a WebAssembly canvas grid with server-mediated OT co-editing. Alpha.',
  image: 'https://casualoffice.org/og.png',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  author: {
    '@type': 'Person',
    '@id': 'https://casualoffice.org/#person',
    name: 'Sachin Sarwa',
    url: 'https://casualoffice.org/',
  },
  isAccessibleForFree: true,
  programmingLanguage: 'Rust',
};

// The npm embed, trimmed to the shape a reader can evaluate in ten seconds.
// Held as a raw string and emitted with set:html so Astro leaves it alone.
const embedJs = `<code>npm install @opencalc/sheet
</code>`;
const embedJs2 = `<code>import "@opencalc/sheet";        // &lt;opencalc-sheet style="height:600px"&gt;

const sheet = document.querySelector("opencalc-sheet");
await sheet.ready;

await sheet.configure({ access: "view" });  // enforced in the engine,
await sheet.open(bytes, "budget.xlsx");     // not by hiding buttons

sheet.on("cellsChanged", async (e) =&gt; {
  if (e.source !== "api") persist(await sheet.save());
});</code>`;
const embedRs = `<code>use casual_calc_sdk::{Environment, SessionConfig, WorkbookSession};

let config = SessionConfig::new()
    .with_limits(limits)        // what an untrusted upload may allocate
    .with_undo_depth(200)
    .with_environment(Environment { now: today_serial, seed });

let mut session = WorkbookSession::open_with(bytes, config)?;</code>`;
---
<Base
  {title}
  {description}
  active="opencalc"
  jsonLd={jsonLd}
  keywords="embeddable spreadsheet engine, rust spreadsheet library, webassembly spreadsheet, xlsx rust, open source spreadsheet sdk, javascript spreadsheet component, wasm xlsx editor, self-hosted spreadsheet engine, opencalc"
>
  <section
    class="hero subpage"
    style="--product-accent: var(--opencalc); --product-accent-soft: var(--opencalc-soft);"
  >
    <div class="container hero__inner reveal">
      <div class="subpage__topline">
        <span class="dot" aria-hidden="true"></span>
        OpenCalc · alpha · successor to Casual Sheets
      </div>
      <h1 class="display">A spreadsheet engine <em>you can put anywhere.</em></h1>
      <p class="lede">
        OpenCalc is an <strong>embeddable spreadsheet engine written in Rust</strong>.
        It reads and writes <code>.xlsx</code>, calculates it, renders a live canvas
        grid, and runs the whole engine client-side in <strong>WebAssembly</strong> — so
        co-editing scales without sticky sessions and the editor keeps working when the
        network hiccups. It is the ground-up successor to
        <a href="/casual-sheets/">Casual Sheets</a>: same job, rewritten as a
        deterministic engine instead of a web app.
      </p>
      <div class="row">
        <a class="btn btn--accent" style="--product-accent: var(--opencalc);" href={editorUrl} rel="noopener" target="_blank">Open the live editor →</a>
        <a class="btn btn--ghost" href={siteUrl} rel="noopener" target="_blank">calc.casualoffice.org</a>
        <a class="btn btn--ghost" href={repoUrl} rel="noopener" target="_blank">Source on GitHub</a>
      </div>
      <p class="lede" style="font-size: 0.92rem; opacity: 0.7; margin-top: 12px;">
        Apache-2.0. <strong>Alpha</strong> — the engine, editor and SDK are live and the
        co-editing stack runs, but interfaces still move and the npm line is published at
        <code>0.0.0</code>. Pin what you test against.
      </p>
    </div>
  </section>

  <!-- The engine itself, embedded. Not a screenshot and not the landing page —
       the actual editor, running as WebAssembly inside this page. -->
  <section class="section" style="--product-accent: var(--opencalc); --product-accent-soft: var(--opencalc-soft);">
    <div class="container">
      <LiveFrame
        title="OpenCalc live editor"
        src={editorUrl}
        addr="calc.casualoffice.org/editor.html"
        accent="var(--opencalc)"
        label="Load the live OpenCalc editor"
        sub="The Rust engine compiled to WebAssembly — it runs in your tab, not on a server"
      />
      <p class="muted" style="margin: 16px auto 0; max-width: 74ch; text-align: center;">
        Open one of your own <code>.xlsx</code> files in it. Nothing is uploaded — the
        engine, the calculation, and the save-back all happen in the browser.
      </p>
    </div>
  </section>

  <section class="section" style="--product-accent: var(--opencalc); --product-accent-soft: var(--opencalc-soft);">
    <div class="container">
      <div class="fact-row">
        <div><div class="fact__label">Status</div><div class="fact__value">alpha</div></div>
        <div><div class="fact__label">Functions</div><div class="fact__value">347 / 356</div></div>
        <div><div class="fact__label">Engine</div><div class="fact__value">Rust → WASM</div></div>
        <div><div class="fact__label">License</div><div class="fact__value">Apache-2.0</div></div>
      </div>
    </div>
  </section>

  <section class="section" style="--product-accent: var(--opencalc); --product-accent-soft: var(--opencalc-soft);">
    <div class="container">
      <div class="section__head">
        <div>
          <span class="eyebrow">Why it is built this way</span>
          <h2 class="title">The engine runs in the browser.<br/>The server only orders operations.</h2>
        </div>
      </div>
      <div class="feature-grid">
        <article class="feature">
          <span class="feature__icon">◱</span>
          <h3 class="feature__title">No sticky sessions</h3>
          <p class="feature__body">
            The server orders operations rather than rendering pixels. A client can go
            offline briefly without the document freezing, and nodes scale horizontally
            without consistent hashing — any node relays to the document&rsquo;s leader, so a
            plain load balancer works.
          </p>
        </article>
        <article class="feature">
          <span class="feature__icon">∅</span>
          <h3 class="feature__title">Nothing is lost silently</h3>
          <p class="feature__body">
            Unmodelled parts of a workbook — VBA, OLE objects, form controls, custom XML —
            are retained byte-for-byte. Anything the model genuinely cannot keep is
            counted and named in a compatibility report rather than dropped quietly.
          </p>
        </article>
        <article class="feature">
          <span class="feature__icon">≡</span>
          <h3 class="feature__title">Determinism is a gated contract</h3>
          <p class="feature__body">
            The same input and version produce identical model, values, layout and bytes.
            Time and randomness are <strong>supplied, never sampled</strong> — an engine that
            reaches for the wall clock cannot be tested, replayed, or agreed on by two
            hosts.
          </p>
        </article>
        <article class="feature">
          <span class="feature__icon">⛨</span>
          <h3 class="feature__title">Access is enforced, not hidden</h3>
          <p class="feature__body">
            <code>configure(&#123; access: "view" &#125;)</code> is enforced inside the engine, not by
            removing buttons. The editor is a custom element with a shadow root, so host
            CSS cannot reach in and its CSS cannot reach out.
          </p>
        </article>
      </div>
    </div>
  </section>

  <section class="section" style="--product-accent: var(--opencalc); --product-accent-soft: var(--opencalc-soft);">
    <div class="container">
      <div class="section__head">
        <div>
          <span class="eyebrow">What it does</span>
          <h2 class="title">A real spreadsheet, not a grid widget.</h2>
        </div>
      </div>
      <div class="feature-grid">
        <article class="feature">
          <span class="feature__icon">⇄</span>
          <h3 class="feature__title">Formats</h3>
          <p class="feature__body">
            <code>.xlsx</code> round-trips as a semantic fixed point, gated in CI.
            CSV/TSV/PSV with RFC 4180 quoting. It reads what other writers actually emit:
            OOXML booleans in either spelling, theme + tint and legacy indexed colours,
            shared formulas, and multi-area <code>sqref</code>.
          </p>
        </article>
        <article class="feature">
          <span class="feature__icon">ƒ</span>
          <h3 class="feature__title">Calculation</h3>
          <p class="feature__body">
            347 of the spec&rsquo;s 356 functions. Dynamic arrays that spill and refuse
            (<code>#SPILL!</code>) rather than overwrite. <code>LET</code> and
            <code>LAMBDA</code> with first-class function values, plus
            <code>MAP</code>/<code>REDUCE</code>/<code>SCAN</code>/<code>BYROW</code>/<code>BYCOL</code>.
            Automatic or manual mode, taken from the file&rsquo;s own <code>&lt;calcPr&gt;</code>.
          </p>
        </article>
        <article class="feature">
          <span class="feature__icon">▦</span>
          <h3 class="feature__title">Features</h3>
          <p class="feature__body">
            Pivot tables with eleven aggregates and <code>GETPIVOTDATA</code>; charts
            written as real chart parts, not pictures; conditional formatting; data
            validation; tables and autofilter; comments; number formats including
            sections and <code>[Red]</code>.
          </p>
        </article>
        <article class="feature">
          <span class="feature__icon">⌨</span>
          <h3 class="feature__title">The editor</h3>
          <p class="feature__body">
            A WASM canvas grid: shared inline / formula-bar editing, autocomplete and
            argument hints, reference picking, <kbd>F4</kbd> anchor cycling, a range
            finder, find &amp; replace, multi-sheet tabs, and undo/redo.
          </p>
        </article>
        <article class="feature">
          <span class="feature__icon">◎</span>
          <h3 class="feature__title">Collaboration</h3>
          <p class="feature__body">
            Server-mediated OT with presence, resume and pipelining. Version history is
            kept at the host — a version is taken <em>before</em> each save, so history
            holds what the document was rather than what it became.
          </p>
        </article>
        <article class="feature">
          <span class="feature__icon">⊞</span>
          <h3 class="feature__title">WOPI for file stores</h3>
          <p class="feature__body">
            Nextcloud, ownCloud, SharePoint, Moodle and Alfresco install an editor the
            same way. Start the adapter, paste one discovery URL into their settings, and
            set <code>OPENCALC_WOPI_ALLOWED_HOSTS</code>. Only formats that round-trip
            unchanged are advertised — a format it would rewrite is silent data loss with
            an administrator&rsquo;s blessing.
          </p>
        </article>
      </div>
    </div>
  </section>

  <section class="section" style="--product-accent: var(--opencalc); --product-accent-soft: var(--opencalc-soft);">
    <div class="container">
      <div class="section__head">
        <div>
          <span class="eyebrow">Embed it</span>
          <h2 class="title">One element in a web app, one session in a Rust host.</h2>
        </div>
      </div>
      <div class="embed">
        <div class="embed__col">
          <span class="embed__label">In a web app</span>
          <pre class="code" set:html={embedJs}></pre>
          <pre class="code" set:html={embedJs2}></pre>
          <p class="embed__note">
            The WebAssembly binary is served from <em>your</em> origin — a Web Worker
            cannot be constructed from a cross-origin URL, and a CDN would foreclose ever
            moving the engine off the main thread. <code>opencalc-assets</code> copies it
            into a directory you serve, and the element refuses to boot on a
            JavaScript ↔ engine version skew rather than returning a wrong answer.
          </p>
        </div>
        <div class="embed__col">
          <span class="embed__label">In a Rust host</span>
          <pre class="code" set:html={embedRs}></pre>
          <p class="embed__note">
            <code>with_limits</code> bounds what an untrusted upload may allocate.
            <code>Environment</code> supplies the clock and the seed, which is what makes a
            session replayable. Published npm packages:
            <code>@opencalc/sheet</code>, <code>@opencalc/react</code>,
            <code>@opencalc/engine</code>.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="section" style="--product-accent: var(--opencalc); --product-accent-soft: var(--opencalc-soft);">
    <div class="container">
      <div class="section__head">
        <div>
          <span class="eyebrow">Honest status</span>
          <h2 class="title">Alpha — live, but still moving.</h2>
        </div>
      </div>
      <div class="feature-grid">
        <article class="feature">
          <h3 class="feature__title">Working today</h3>
          <p class="feature__body">
            The engine, the browser editor, the co-editing server, the npm SDK and the
            WOPI adapter all run. Two containers gets you co-editing over a link; a
            cluster is two nodes behind nginx coordinating through Redis.
          </p>
        </article>
        <article class="feature">
          <h3 class="feature__title">Known gaps</h3>
          <p class="feature__body">
            No PDF export and no <code>.ods</code> support yet. Interfaces still move
            while the SDK sits at <code>0.0.0</code> — pre-1.0, a rename is a minor
            version.
          </p>
        </article>
        <article class="feature">
          <h3 class="feature__title">Relationship to Casual Sheets</h3>
          <p class="feature__body">
            <a href="/casual-sheets/">Casual Sheets</a> is the shipping TypeScript web app
            and is what <code>sheet.casualoffice.org</code> runs today. OpenCalc is its
            successor and is <strong>not yet a drop-in replacement</strong> — both are
            developed in the open, and the engine is where new work goes.
          </p>
        </article>
      </div>
    </div>
  </section>

  <section class="section" style="--product-accent: var(--opencalc); --product-accent-soft: var(--opencalc-soft);">
    <div class="container container--narrow">
      <div class="callout">
        <strong>Try it, then embed it.</strong> The editor above is the real engine. When
        you want it in your own app, <code>npm install @opencalc/sheet</code> — or run
        <code>docker compose up</code> from the repo for the two-container co-editing
        demo.
      </div>
      <div class="row" style="margin-top: 22px;">
        <a class="btn btn--accent" style="--product-accent: var(--opencalc);" href={editorUrl} rel="noopener" target="_blank">Open the live editor →</a>
        <a class="btn btn--ghost" href={repoUrl} rel="noopener" target="_blank">Source on GitHub</a>
        <a class="btn btn--ghost" href="/casual-sheets/">Casual Sheets (the app)</a>
      </div>
    </div>
  </section>
</Base>

<style>
  /* The homepage has an identical two-column embed block, but Astro scopes
     component styles — those rules do not reach this page, so the layout is
     restated here rather than promoted into global.css for two consumers. */
  .embed { display: grid; grid-template-columns: 1fr 1fr; gap: 28px; }
  @media (max-width: 820px) { .embed { grid-template-columns: 1fr; } }
  .embed__col { display: flex; flex-direction: column; gap: 10px; }
  .embed__label {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.1em;
    color: var(--text-dim);
    text-transform: uppercase;
    font-weight: 600;
  }
  .embed__note { margin: 8px 0 0; color: var(--text-muted); font-size: 13.5px; line-height: 1.6; }
  .code {
    margin: 0;
    padding: 16px 18px;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    font-family: var(--font-mono);
    font-size: 13px;
    line-height: 1.65;
    overflow-x: auto;
  }
  .code code { background: none; padding: 0; font-size: inherit; }
</style>
