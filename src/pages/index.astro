<!-- Tab switcher for the live demo. Tiny vanilla JS — no framework needed
     for three buttons. Flips ARIA attrs + show/hide classes. Iframes stay
     mounted so switching back doesn't re-load. -->
<script is:inline>
  (function () {
    const tabs = document.querySelectorAll('[data-demo]');
    const panels = {
      dochub: document.getElementById('demo-dochub'),
      sheets: document.getElementById('demo-sheets'),
      editor: document.getElementById('demo-editor'),
    };
    const frame = document.querySelector('[data-frame]');
    const addrs = document.querySelectorAll('[data-addr]');
    const pops = document.querySelectorAll('[data-pop-for]');
    const FRAME_ACCENTS = {
      dochub: 'var(--dochub)',
      sheets: 'var(--sheets)',
      editor: 'var(--editor)',
    };
    tabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        const key = tab.dataset.demo;
        tabs.forEach((t) => {
          const on = t === tab;
          t.classList.toggle('demo__tab--active', on);
          t.setAttribute('aria-selected', on ? 'true' : 'false');
        });
        Object.entries(panels).forEach(([k, panel]) => {
          if (!panel) return;
          panel.classList.toggle('frame__panel--hidden', k !== key);
        });
        if (frame) frame.style.setProperty('--frame-accent', FRAME_ACCENTS[key]);
        addrs.forEach((a) => {
          a.classList.toggle('frame__addr--hidden', a.dataset.addr !== key);
        });
        pops.forEach((p) => {
          p.classList.toggle('demo__pop--hidden', p.dataset.popFor !== key);
        });
      });
    });

    // Click-to-load facade. The demo iframes carry `data-src` (not `src`) so the
    // multi-MB apps aren't fetched on page load — they were the bulk of the
    // homepage payload + main-thread work. Inject the real src on demand.
    document.querySelectorAll('[data-load-frame]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const panel = btn.closest('.frame__panel');
        const iframe = panel && panel.querySelector('iframe');
        if (iframe && !iframe.getAttribute('src') && iframe.dataset.src) {
          iframe.setAttribute('src', iframe.dataset.src);
        }
        btn.remove();
      });
    });
  })();
</script>

