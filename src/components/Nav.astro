---
/**
 * Top navigation. Sticky, blurred backdrop. Mobile-first:
 *
 *  - ≥ 880px  → full horizontal link row, products behind one "Products"
 *               disclosure so the bar stays one line.
 *  - < 880px  → brand + hamburger; links collapse into a full-width
 *               drop panel toggled by the button. The panel is keyboard
 *               reachable, closes on Escape / outside-click / link-tap,
 *               and locks body scroll while open.
 *
 * `active` highlights the matching link. The product formerly called
 * "Casual Editor" is now "Casual Docs" (route stays /casual-docs/); the
 * long-form documentation section is labelled "Guides" so the two don't
 * collide in the bar.
 *
 * Why products are grouped rather than listed flat: the suite is nine
 * entries once the engines (OpenCalc, OpenDoc) and the platform (Enclave)
 * are counted. Flat, that is ~1050px of links, which overflows the bar
 * everywhere between the 880px mobile breakpoint and a wide desktop. The
 * disclosure keeps the top level to four items at every width. On mobile
 * the disclosure flattens back out — the panel already scrolls, so a
 * nested toggle there would be a tap for nothing.
 *
 * The right-most "Star on GitHub" affordance is the primary CTA on a
 * community-first project — a pill, not a salesy button.
 */
type ActiveLink =
  | 'home'
  | 'sheets'
  | 'editor'
  | 'slides'
  | 'desktop'
  | 'pdf'
  | 'ras'
  | 'opencalc'
  | 'opendoc'
  | 'enclave'
  | 'docs'
  | 'notes'
  | 'changelog'
  | 'about';
const { active = 'home' } = Astro.props as { active?: ActiveLink };

// Two groups inside the Products disclosure. "Apps" are the things a person
// opens; "Engines & platform" are the things a developer embeds or deploys.
const productGroups: { title: string; items: { slug: ActiveLink; label: string; note: string; href: string }[] }[] = [
  {
    title: 'Apps',
    items: [
      { slug: 'sheets', label: 'Casual Sheets', note: '.xlsx spreadsheet', href: '/casual-sheets/' },
      { slug: 'editor', label: 'Casual Docs', note: '.docx editor', href: '/casual-docs/' },
      { slug: 'slides', label: 'Casual Slides', note: '.pptx slides', href: '/casual-slides/' },
      { slug: 'pdf', label: 'Casual PDF', note: 'PDF viewer + editor', href: '/casual-pdf/' },
      { slug: 'desktop', label: 'Casual Desktop', note: 'native binaries', href: '/casual-desktop/' },
      { slug: 'ras', label: 'Casual RAS', note: 'embeddable remote access', href: '/casual-ras/' },
    ],
  },
  {
    title: 'Engines & platform',
    items: [
      { slug: 'opencalc', label: 'OpenCalc', note: 'Rust spreadsheet engine', href: '/opencalc/' },
      { slug: 'opendoc', label: 'OpenDoc', note: 'Rust DOCX engine', href: '/opendoc/' },
      { slug: 'enclave', label: 'Enclave', note: 'enterprise workspace', href: '/enclave/' },
    ],
  },
];

const productSlugs = productGroups.flatMap((g) => g.items.map((i) => i.slug));
const productsActive = productSlugs.includes(active);

const links: { slug: ActiveLink; label: string; href: string }[] = [
  { slug: 'docs', label: 'Guides', href: '/docs/' },
  { slug: 'notes', label: 'Notes', href: '/notes/' },
  { slug: 'changelog', label: 'Changelog', href: '/changelog/' },
];
---

<nav class="nav" aria-label="Primary" data-nav>
  <a class="nav__brand" href="/" aria-label="Casual Office home">
    <span class="nav__mark" aria-hidden="true">
      <svg viewBox="0 0 64 64" width="28" height="28">
        <rect width="64" height="64" rx="14" fill="#14110c"/>
        <rect x="24" y="13" width="22" height="30" rx="4" fill="#6f6a57"/>
        <rect x="20" y="17" width="22" height="30" rx="4" fill="#a8a29e"/>
        <rect x="16" y="21" width="22" height="30" rx="4" fill="#f4f1ea"/>
        <g fill="#14110c">
          <rect x="20" y="28" width="14" height="3" rx="1.5"/>
          <rect x="20" y="34" width="14" height="3" rx="1.5"/>
          <rect x="20" y="40" width="9" height="3" rx="1.5"/>
        </g>
        <rect x="35" y="38" width="8" height="8" rx="2" fill="#ea580c"/>
      </svg>
    </span>
    Casual Office
  </a>

  <button
    type="button"
    class="nav__toggle"
    aria-label="Open menu"
    aria-expanded="false"
    aria-controls="nav-menu"
    data-nav-toggle
  >
    <span class="nav__toggle-bars" aria-hidden="true"><span></span><span></span><span></span></span>
  </button>

  <div class="nav__links" id="nav-menu" data-nav-menu>
    <div class="nav__group" data-nav-group>
      <button
        type="button"
        class={productsActive ? 'nav__link nav__link--active nav__products' : 'nav__link nav__products'}
        aria-expanded="false"
        aria-controls="nav-products"
        data-nav-group-toggle
      >
        Products
        <svg class="nav__caret" viewBox="0 0 12 12" width="10" height="10" aria-hidden="true">
          <path fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" d="m2.5 4.5 3.5 3.5 3.5-3.5"/>
        </svg>
      </button>
      <div class="nav__dropdown" id="nav-products" data-nav-dropdown>
        {productGroups.map((group) => (
          <div class="nav__dropcol">
            <span class="nav__droptitle">{group.title}</span>
            {group.items.map((i) => (
              <a
                class={i.slug === active ? 'nav__drop nav__drop--active' : 'nav__drop'}
                href={i.href}
                aria-current={i.slug === active ? 'page' : undefined}
              >
                <span class="nav__drop-label">{i.label}</span>
                <span class="nav__drop-note">{i.note}</span>
              </a>
            ))}
          </div>
        ))}
      </div>
    </div>

    {links.map((l) => (
      <a
        class={l.slug === active ? 'nav__link nav__link--active' : 'nav__link'}
        href={l.href}
        aria-current={l.slug === active ? 'page' : undefined}
      >{l.label}</a>
    ))}
    <a
      class="nav__star"
      href="https://github.com/CasualOffice"
      rel="noopener"
      target="_blank"
      aria-label="View on GitHub"
    >
      <svg viewBox="0 0 24 24" width="14" height="14" aria-hidden="true">
        <path
          fill="currentColor"
          d="M12 .3a12 12 0 0 0-3.8 23.4c.6.1.8-.3.8-.6v-2c-3.3.7-4-1.6-4-1.6-.5-1.4-1.3-1.7-1.3-1.7-1.1-.7.1-.7.1-.7 1.2.1 1.8 1.2 1.8 1.2 1.1 1.8 2.8 1.3 3.5 1 .1-.8.4-1.3.8-1.6-2.7-.3-5.5-1.3-5.5-6 0-1.3.5-2.4 1.2-3.2-.1-.3-.5-1.6.1-3.2 0 0 1-.3 3.3 1.2a11.5 11.5 0 0 1 6 0c2.3-1.5 3.3-1.2 3.3-1.2.7 1.6.3 2.9.1 3.2.8.8 1.2 1.9 1.2 3.2 0 4.7-2.8 5.7-5.5 6 .4.4.8 1.1.8 2.2v3.3c0 .3.2.7.8.6A12 12 0 0 0 12 .3"
        />
      </svg>
      <span class="nav__star-label">Star on GitHub</span>
    </a>
  </div>

  <span class="nav__scrim" data-nav-scrim aria-hidden="true"></span>
</nav>

<script is:inline>
  (function () {
    const nav = document.querySelector('[data-nav]');
    if (!nav) return;
    const toggle = nav.querySelector('[data-nav-toggle]');
    const menu = nav.querySelector('[data-nav-menu]');
    const scrim = nav.querySelector('[data-nav-scrim]');
    const group = nav.querySelector('[data-nav-group]');
    const groupToggle = nav.querySelector('[data-nav-group-toggle]');
    const mq = window.matchMedia('(max-width: 879px)');

    function setGroupOpen(open) {
      if (!group) return;
      group.classList.toggle('nav__group--open', open);
      groupToggle.setAttribute('aria-expanded', open ? 'true' : 'false');
    }

    function setOpen(open) {
      nav.classList.toggle('nav--open', open);
      toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
      toggle.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
      // Only trap scroll on the mobile breakpoint.
      document.body.style.overflow = open && mq.matches ? 'hidden' : '';
      if (!open) setGroupOpen(false);
    }

    toggle.addEventListener('click', () => setOpen(!nav.classList.contains('nav--open')));
    scrim && scrim.addEventListener('click', () => setOpen(false));

    // Below 880px the dropdown is rendered inline and always visible, so the
    // disclosure button is hidden and this handler never fires there.
    groupToggle &&
      groupToggle.addEventListener('click', (e) => {
        e.stopPropagation();
        setGroupOpen(!group.classList.contains('nav__group--open'));
      });

    menu.addEventListener('click', (e) => {
      if (e.target.closest('a')) setOpen(false);
    });
    document.addEventListener('click', (e) => {
      if (group && !group.contains(e.target)) setGroupOpen(false);
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') setOpen(false);
    });
    // Reset state if the viewport grows past the mobile breakpoint.
    mq.addEventListener('change', () => setOpen(false));
  })();
</script>

<style>
  /* Brand mark — neobrutal ink tile with the document-stack SVG. Retires the
     conic-gradient blob from the v3/v4 look. */
  .nav__mark {
    width: 28px;
    height: 28px;
    border-radius: 8px;
    background: none;
    box-shadow: none;
    overflow: visible;
    display: inline-flex;
  }
  .nav__mark::before,
  .nav__mark::after { display: none; }
  .nav__mark svg { display: block; border-radius: 8px; }

  /* Hamburger button — hidden on desktop, shown under 880px. */
  .nav__toggle {
    display: none;
    appearance: none;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    margin: -4px -6px -4px 0;
    padding: 0;
    background: transparent;
    border: 1px solid transparent;
    border-radius: 10px;
    color: var(--text);
    cursor: pointer;
    transition: background-color 120ms ease, border-color 120ms ease;
  }
  .nav__toggle:hover { background: var(--surface-2); }
  .nav__toggle:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
  .nav__toggle-bars,
  .nav__toggle-bars span {
    display: block;
    box-sizing: border-box;
  }
  .nav__toggle-bars {
    position: relative;
    width: 20px;
    height: 14px;
  }
  .nav__toggle-bars span {
    position: absolute;
    left: 0;
    width: 100%;
    height: 2px;
    border-radius: 2px;
    background: currentColor;
    transition: transform 200ms ease, opacity 160ms ease, top 200ms ease;
  }
  .nav__toggle-bars span:nth-child(1) { top: 0; }
  .nav__toggle-bars span:nth-child(2) { top: 6px; }
  .nav__toggle-bars span:nth-child(3) { top: 12px; }
  .nav--open .nav__toggle-bars span:nth-child(1) { top: 6px; transform: rotate(45deg); }
  .nav--open .nav__toggle-bars span:nth-child(2) { opacity: 0; }
  .nav--open .nav__toggle-bars span:nth-child(3) { top: 6px; transform: rotate(-45deg); }

  /* ── Products disclosure ─────────────────────────────────────────── */
  .nav__group { position: relative; }
  .nav__products {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    appearance: none;
    background: transparent;
    border: 0;
    cursor: pointer;
    font: inherit;
  }
  .nav__caret {
    transition: transform var(--dur-1) var(--ease);
    opacity: 0.6;
  }
  .nav__group--open .nav__caret { transform: rotate(180deg); }

  .nav__dropdown {
    position: absolute;
    top: calc(100% + 10px);
    left: 50%;
    transform: translate(-50%, -6px);
    display: grid;
    grid-template-columns: repeat(2, minmax(190px, 1fr));
    gap: 4px 22px;
    padding: 14px;
    background: var(--card);
    border: var(--border-w) solid var(--border);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-lg);
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: opacity 160ms ease, transform 160ms ease, visibility 0s linear 160ms;
  }
  .nav__group--open .nav__dropdown {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transform: translate(-50%, 0);
    transition: opacity 160ms ease, transform 160ms ease, visibility 0s;
  }
  .nav__dropcol { display: flex; flex-direction: column; gap: 2px; }
  .nav__droptitle {
    font-family: var(--font-mono);
    font-size: 10.5px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--text-dim);
    padding: 4px 10px 6px;
  }
  .nav__drop {
    display: flex;
    flex-direction: column;
    gap: 1px;
    padding: 7px 10px;
    border-radius: 10px;
    text-decoration: none;
    color: var(--text);
    transition: background-color var(--dur-1) var(--ease);
  }
  .nav__drop:hover { background: var(--surface-2); text-decoration: none; }
  .nav__drop--active { background: var(--surface-2); }
  .nav__drop-label { font-size: 14px; font-weight: 550; letter-spacing: -0.01em; }
  .nav__drop-note { font-size: 11.5px; color: var(--text-dim); font-family: var(--font-mono); }

  .nav__star {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 8px 15px;
    margin-left: 8px;
    border: 1px solid transparent;
    border-radius: 999px;
    color: var(--bg);
    font-family: var(--font-sans);
    font-size: 13px;
    font-weight: 550;
    letter-spacing: -0.01em;
    text-decoration: none;
    box-shadow: var(--shadow-sm);
    transition:
      transform var(--dur-1) var(--ease),
      box-shadow var(--dur-2) var(--ease),
      opacity var(--dur-1) var(--ease);
    background: var(--text);
  }
  .nav__star:hover {
    transform: translateY(-1px);
    box-shadow: var(--shadow-md);
    opacity: 0.92;
    color: var(--bg);
  }
  .nav__star:active { transform: translateY(0); }

  .nav__scrim { display: none; }

  /* ── Mobile: collapse links into a drop panel ───────────────────── */
  @media (max-width: 879px) {
    .nav__toggle { display: inline-flex; }

    .nav__links {
      position: absolute;
      top: calc(100% + 1px);
      left: 0;
      right: 0;
      flex-direction: column;
      align-items: stretch;
      gap: 2px;
      padding: 10px 16px calc(14px + env(safe-area-inset-bottom));
      background: var(--bg);
      border-bottom: 1px solid var(--border);
      box-shadow: var(--shadow-lg);
      max-height: calc(100dvh - 60px);
      overflow-y: auto;
      transform: translateY(-8px);
      opacity: 0;
      visibility: hidden;
      pointer-events: none;
      transition: opacity 180ms ease, transform 180ms ease, visibility 0s linear 180ms;
    }
    .nav--open .nav__links {
      transform: translateY(0);
      opacity: 1;
      visibility: visible;
      pointer-events: auto;
      transition: opacity 180ms ease, transform 180ms ease, visibility 0s;
    }
    .nav__link {
      padding: 12px 12px;
      font-size: 16px;
      border-radius: 10px;
    }

    /* The disclosure flattens: the button disappears and the two columns
       stack inline, so every product is one tap away instead of two. */
    .nav__products { display: none; }
    .nav__dropdown {
      position: static;
      transform: none;
      display: flex;
      flex-direction: column;
      gap: 2px;
      padding: 0;
      background: none;
      border: 0;
      border-radius: 0;
      box-shadow: none;
      opacity: 1;
      visibility: visible;
      pointer-events: auto;
      transition: none;
    }
    .nav__drop { padding: 10px 12px; }
    .nav__drop-label { font-size: 15.5px; }
    .nav__droptitle { padding: 12px 12px 6px; }

    .nav__star {
      margin: 8px 0 0;
      justify-content: center;
      padding: 12px;
      font-size: 14px;
    }
    .nav__star-label { display: inline; }

    .nav--open .nav__scrim {
      display: block;
      position: fixed;
      inset: 0;
      top: 0;
      z-index: -1;
      background: rgba(12, 10, 9, 0.32);
      -webkit-backdrop-filter: blur(1px);
      backdrop-filter: blur(1px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .nav__links,
    .nav__dropdown,
    .nav__caret,
    .nav__toggle-bars span { transition: none; }
  }
</style>
