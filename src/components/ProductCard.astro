---
interface Props {
  slug: 'sheets' | 'editor' | 'slides' | 'desktop' | 'pdf' | 'ras' | 'opencalc' | 'opendoc' | 'enclave';
  name: string;
  role: string;
  body: string;
  features: string[];
  status: string;
  href: string;
  accent: string;
  accentSoft: string;
}
const { slug, name, role, body, features, status, href, accent, accentSoft } = Astro.props as Props;

// Chroma is sandboxed to this glyph chip — the one place product color lives
// on the card. The frame stays neutral ink (the restrained umbrella rule).
const glyph: Record<Props['slug'], string> = {
  sheets: 'S',
  editor: 'D',
  slides: 'P',
  desktop: '▤',
  pdf: 'F',
  ras: '⧉',
  opencalc: 'Σ',
  opendoc: '¶',
  enclave: '◈',
};
---
<a
  class="product spot"
  href={href}
  data-product={slug}
  style={`--product-accent: ${accent}; --product-accent-soft: ${accentSoft};`}
>
  <div class="product__head">
    <span class="product__mark" aria-hidden="true">{glyph[slug]}</span>
    <span class="product__titles">
      <h2 class="product__name">{name}</h2>
      <div class="product__role">{role}</div>
    </span>
  </div>
  <p class="product__body">{body}</p>
  <ul class="product__features">
    {features.map((f) => <li>{f}</li>)}
  </ul>
  <div class="product__cta">
    <span class="product__status">{status}</span>
    <span class="product__open">Read more →</span>
  </div>
</a>
