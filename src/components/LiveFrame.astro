---
/**
 * A single embedded live app, inside faux browser chrome.
 *
 * The homepage has its own multi-tab version of this in `index.astro`;
 * this component is the one-app case, for the product pages. It is a
 * separate component rather than a shared style block because Astro
 * scopes component CSS — the homepage's `.frame` rules do not reach
 * another page.
 *
 * The iframe carries `data-src`, not `src`. These are multi-megabyte
 * WebAssembly editors; fetching one on page load would dominate the
 * product page's payload for a visitor who never scrolls to it. A click
 * on the facade injects the real `src`.
 */
interface Props {
  /** Accessible iframe title + what the load button announces. */
  title: string;
  /** The URL to load on click. Point this at the editor, not a landing page. */
  src: string;
  /** What to print in the fake address bar. */
  addr: string;
  /** CSS colour for the play button — usually `var(--opencalc)` etc. */
  accent: string;
  /** Button label, e.g. "Load the live OpenCalc editor". */
  label: string;
  /** Second line under the label — set expectations about size/behaviour. */
  sub: string;
}
const { title, src, addr, accent, label, sub } = Astro.props as Props;
---
<div class="frame" style={`--frame-accent: ${accent};`}>
  <div class="frame__chrome">
    <span class="frame__btn" style="background: #ff5f57"></span>
    <span class="frame__btn" style="background: #febc2e"></span>
    <span class="frame__btn" style="background: #28c840"></span>
    <span class="frame__addr">{addr}</span>
  </div>
  <div class="frame__panel">
    <button type="button" class="frame__load" data-live-frame-load>
      <span class="frame__load-play" aria-hidden="true">▶</span>
      {label}
      <span class="frame__load-sub">{sub}</span>
    </button>
    <iframe {title} data-src={src} loading="lazy" allow="clipboard-read; clipboard-write"></iframe>
  </div>
</div>

<script>
  document.querySelectorAll('[data-live-frame-load]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const panel = btn.closest('.frame__panel');
      const iframe = panel && panel.querySelector('iframe');
      if (iframe instanceof HTMLIFrameElement && !iframe.getAttribute('src') && iframe.dataset.src) {
        iframe.setAttribute('src', iframe.dataset.src);
      }
      btn.remove();
    });
  });
</script>

<style>
  .frame {
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: var(--radius-xl);
    overflow: hidden;
    position: relative;
    box-shadow: var(--shadow-xl);
  }
  .frame__chrome {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 13px 18px;
    border-bottom: 1px solid var(--border);
    background: color-mix(in srgb, var(--surface) 70%, var(--card));
  }
  .frame__btn { width: 11px; height: 11px; border-radius: 50%; display: inline-block; flex-shrink: 0; }
  .frame__addr {
    margin-left: 16px;
    color: var(--text-muted);
    font-family: var(--font-mono);
    font-size: 12px;
    padding: 5px 16px;
    background: var(--surface);
    border-radius: var(--radius-pill);
    border: 1px solid var(--border);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .frame__panel { position: relative; height: clamp(480px, 64vh, 720px); display: block; }
  .frame__panel iframe {
    width: 100%;
    height: 100%;
    border: 0;
    display: block;
    background: var(--surface);
  }
  .frame__load {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 10px;
    padding: 0 20px;
    text-align: center;
    border: 0;
    cursor: pointer;
    background: var(--surface);
    color: var(--text);
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 17px;
    letter-spacing: -0.015em;
  }
  .frame__load:hover { background: var(--surface-2); }
  .frame__load:focus-visible { outline: 2px solid var(--frame-accent, var(--accent)); outline-offset: -4px; }
  .frame__load-play {
    display: grid;
    place-items: center;
    width: 56px;
    height: 56px;
    border-radius: 50%;
    background: var(--frame-accent, var(--accent));
    color: #fff;
    font-size: 18px;
    padding-left: 3px;
    box-shadow: 0 10px 30px -8px color-mix(in srgb, var(--frame-accent, var(--accent)) 60%, transparent);
  }
  .frame__load-sub {
    font-family: var(--font-sans);
    font-weight: 400;
    font-size: 13px;
    color: var(--text-muted);
  }
</style>
